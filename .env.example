# Copy this file to .env and fill in the values. Do not commit .env.

# BoardGameGeek XML API token, used only by `pnpm bgg:update`.
# Register an application at https://boardgamegeek.com/using_the_xml_api to get one.
# Vite exposes only VITE_* variables to the site, so this token never reaches the bundle.
BGG_API_TOKEN=
